}

model WebhookDelivery {
  id             String              @id @default(uuid()) @map("投递编号")
  subscriptionId String              @map("订阅编号")
  event          String              @map("事件")
  payload        Json?               @map("投递内容")
  status         String              @default("待投递") @map("投递状态")
  httpCode       Int?                @map("HTTP状态码")
  attempts       Int                 @default(0) @map("尝试次数")
  nextRetryAt    DateTime?           @map("下次重试时间")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now()) @map("创建时间")

  @@index([subscriptionId, status])
  @@map("Webhook投递")
}

model AuditLog {
  id         String     @id @default(uuid()) @map("日志编号")
  tenantId   String     @map("租户编号")
  actorId    String?    @map("操作人编号")
  actorType  AuditActor @default(USER) @map("操作人类型")
  action     String     @map("操作动作")
  objectType String?    @map("对象类型")
  objectId   String?    @map("对象编号")
  before     Json?      @map("变更前")
  after      Json?      @map("变更后")
  ip         String?    @map("IP地址")
  ua         String?    @map("用户代理")
  at         DateTime   @default(now()) @map("操作时间")

  @@index([tenantId, at])
  @@index([objectType, objectId])
  @@map("审计日志")
}

model Notification {
  id          String   @id @default(uuid()) @map("通知编号")
  tenantId    String   @map("租户编号")
  userId      String   @map("接收人编号")
  type        String   @map("通知类型")
  title       String   @map("标题")
  content     String?  @map("内容")
  relatedType String?  @map("关联类型")
  relatedId   String?  @map("关联编号")
  isRead      Boolean  @default(false) @map("是否已读")
  at          DateTime @default(now()) @map("产生时间")

  @@index([userId, isRead])
  @@map("站内通知")
}

model Dict {
  id        String     @id @default(uuid()) @map("字典编号")
  tenantId  String     @map("租户编号")
  code      String     @map("字典编码")
  name      String     @map("字典名称")
  items     DictItem[]
  createdAt DateTime   @default(now()) @map("创建时间")

  @@unique([tenantId, code])
  @@map("数据字典")
}

model DictItem {
  id      String  @id @default(uuid()) @map("字典项编号")
  dictId  String  @map("字典编号")
  label   String  @map("显示名")
  value   String  @map("取值")
  sort    Int     @default(0) @map("排序")
  enabled Boolean @default(true) @map("是否启用")
  dict    Dict    @relation(fields: [dictId], references: [id], onDelete: Cascade)

  @@index([dictId])
  @@map("字典项")
}
