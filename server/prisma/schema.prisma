  lastUsedAt DateTime?             @map("最近使用时间")
  webhooks   WebhookSubscription[]
  createdAt  DateTime              @default(now()) @map("创建时间")

  @@map("开放密钥")
}

model WebhookSubscription {
  id         String            @id @default(uuid()) @map("订阅编号")
  tenantId   String            @map("租户编号")
  apiKeyId   String            @map("密钥编号")
  event      String            @map("事件")
  url        String            @map("回调地址")
  secret     String?           @map("签名密钥")
  enabled    Boolean           @default(true) @map("是否启用")
  apiKey     ApiKey            @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now()) @map("创建时间")

