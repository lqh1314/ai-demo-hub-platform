# ========= 服务 =========
# 后端监听端口
PORT=3000
NODE_ENV=production

# ========= 数据库（PostgreSQL 15）=========
DATABASE_URL=postgresql://demo:demo123@localhost:5432/ai_demo_hub?schema=public

# ========= Redis（可选；不配置时自动降级为进程内内存，单机演示可留空）=========
REDIS_URL=

# ========= JWT 鉴权 =========
# 生产请替换为高强度随机串（建议 >= 48 字节）
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=2h

# ========= 凭证加密（AES-256-GCM）=========
# 供应商密钥落库加密主密钥；代码会对其做 sha256 取 32 字节，生产务必替换
CREDENTIAL_KEY=change-me-credential-master-key

# ========= CTI 运营商回调安全 =========
# 配置后回调请求必须带匹配的请求头 x-cti-secret；生产环境(NODE_ENV=production)强制要求，缺失即拒绝服务
CTI_WEBHOOK_SECRET=
# 生产是否保留“模拟来电”演示入口（默认关闭；仅在需要演示时置 true）
ALLOW_DEMO_INBOUND=false

# ========= 多租户 =========
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ========= 前端 =========
# 生产同源部署时可留空；跨域时填写后端地址
VITE_API_BASE=
